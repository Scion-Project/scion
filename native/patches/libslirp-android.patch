--- a/src/slirp.c
+++ b/src/slirp.c
@@ -386,11 +386,27 @@
 #else // !defined(_WIN32) && !defined(__APPLE__)
 
 #if defined(__HAIKU__)
-#define RESOLV_CONF_PATH "/boot/system/settings/network/resolv.conf"
+#define RESOLV_CONF_DEFAULT "/boot/system/settings/network/resolv.conf"
 #else
-#define RESOLV_CONF_PATH "/etc/resolv.conf"
+#define RESOLV_CONF_DEFAULT "/etc/resolv.conf"
 #endif
 
+/*
+ * Scion: Android has no /etc/resolv.conf. The app writes the network's
+ * resolvers to a file in resolv.conf format and names it in
+ * SLIRP_RESOLV_CONF before QEMU starts. The variable is read once.
+ */
+static const char *resolv_conf_path(void)
+{
+    static const char *path;
+    if (!path) {
+        const char *env = g_getenv("SLIRP_RESOLV_CONF");
+        path = (env && env[0]) ? g_strdup(env) : RESOLV_CONF_DEFAULT;
+    }
+    return path;
+}
+#define RESOLV_CONF_PATH resolv_conf_path()
+
 static int get_dns_addr_cached(void *pdns_addr, void *cached_addr,
                                socklen_t addrlen, struct stat *cached_stat,
                                unsigned *cached_time)
